<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Coarse only: city-level accuracy is all a forecast can use. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ...and the permission alone would have Play read the hardware as REQUIRED and
         filter the app off devices that have none. Saved places are the main way to
         use Chiaro; the device position is the optional half. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <!-- Asked the first time the reader turns on something that needs it, never at
         startup (VISION.md §5.8). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms do not survive a reboot and WorkManager's persistence does not extend
         to them, so without this the sky reminders would go quiet after a restart and
         nothing would say why. Deliberately NOT here: SCHEDULE_EXACT_ALARM — the
         reminders are inexact by design, which is also why the shortest lead is 15
         minutes. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ChiaroApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chiaro">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Chiaro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The per-widget settings, opened by the launcher's reconfigure flow
             (long-press → the pencil). Exported because the HOST starts it; it acts
             only on the appWidgetId it is handed and reads nothing sensitive. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Chiaro">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The home widgets (Fase 8): Now, Today, Sky. exported=false — the system
             delivers APPWIDGET_* regardless, and nothing else needs in. -->
        <receiver
            android:name=".widget.NowWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_now_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_info" />
        </receiver>
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.SkyWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_sky_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sky_info" />
        </receiver>

        <!-- The one alarm of the sky reminders (Fase 5), plus the boot re-arm.
             exported=false: BOOT_COMPLETED is a protected broadcast the system is
             exempt from the export check for, and our own alarm intent is explicit,
             so nothing else can make this fire. -->
        <receiver
            android:name=".notifications.SkyAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
