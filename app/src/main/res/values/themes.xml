<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The activity draws its own Compose theme; this exists so the window has a
         sane background before the first frame. DayNight, because Chiaro follows the
         system in both directions (VISION.md §4.1). NoActionBar, learned on a device:
         the parent theme ships a system bar that prints the app label above the
         Compose UI, and nothing in Chiaro ever asked for it. -->
    <style name="Theme.Chiaro" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
