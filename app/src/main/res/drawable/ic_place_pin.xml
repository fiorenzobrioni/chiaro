<?xml version="1.0" encoding="utf-8"?>
<!-- The position pin, for the widgets. It is Material Icons' own `place` in the
     outlined theme, path taken verbatim from google/material-design-icons
     (`src/maps/place/materialiconsoutlined/24px.svg`, Apache-2.0,
     `licenses/MaterialIcons-Apache-2.0.txt`) — which is the same drawing the app
     screen already puts before a GPS place name through `Icons.Outlined.LocationOn`.
     Copied rather than shared because Glance cannot draw a Compose ImageVector: it
     wants a resource id. Same glyph on both sides of the fence, so they cannot
     disagree about what "my position" looks like; if one is ever redrawn, the other
     is the second half of that job.
     Color is irrelevant: the caller tints it to its own ink. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12 12c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm6-1.8C18 6.57 15.35 4 12 4s-6 2.57-6 6.2c0 2.34 1.95 5.44 6 9.14 4.05-3.7 6-6.8 6-9.14zM12 2c4.2 0 8 3.22 8 8.2 0 3.32-2.67 7.25-8 11.8-5.33-4.55-8-8.48-8-11.8C4 5.22 7.8 2 12 2z"
        android:fillColor="#FF000000"/>
</vector>
