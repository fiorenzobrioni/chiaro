<!-- The mark, redrawn (committente, 23 set 2026): THE DAY IN A RING.

     The ring is one day of twenty-four hours, painted the way the app paints the sky: a
     sweep gradient that starts at three o'clock (18:00, the dusk's amber) and runs
     clockwise through the night's indigo to midnight at the bottom, the dawn's amber at
     nine o'clock, and the noon blue at the top. The stops are the vivid sky table's
     (SkyPalette, DESIGN §3.7) read at its anchors — horizon amber, civil-twilight violet,
     night navy, midday azure — so the badge and the canvas are one sky.

     The sun sits ON the ring at the hour a reader most often meets the app, mid
     afternoon, and a clip cuts the ring 3 dp wider than the disc around it: the gap is
     what turns the ring into a C, the name's initial, and what keeps the disc a sun on
     a path rather than a bead on a bracelet. It is the Today screen's daylight ribbon
     bent into a dial, and the arc widget's sun on its path.

     Geometry, all inside the 33-unit safe circle of every launcher mask: ring radius 21
     with a 10 stroke (outer edge 26), sun radius 8.2 centred 21 out at −40° (its far
     edge at 29.2), the gap radius 11.2 (32.2). The <monochrome> layer is its own drawable,
     ic_launcher_monochrome, because a sweep gradient's alpha is not a shape.

     It replaces the starry-night crescent over two waves (3 set), which drew the one hour
     this app is least about. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group>
    <clip-path android:pathData="M 0,0 H 108 V 108 H 0 Z M 58.89,40.50 a 11.20,11.20 0 1,0 22.40,0 a 11.20,11.20 0 1,0 -22.40,0 z"/>
    <path android:pathData="M 33.00,54.00 a 21.00,21.00 0 1,0 42.00,0 a 21.00,21.00 0 1,0 -42.00,0 z" android:strokeWidth="10" android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="sweep" android:centerX="54" android:centerY="54">
                <item android:offset="0" android:color="#FFF08A1A"/>
                <item android:offset="0.07" android:color="#FF6B4FC8"/>
                <item android:offset="0.16" android:color="#FF1B2A78"/>
                <item android:offset="0.25" android:color="#FF0D1646"/>
                <item android:offset="0.34" android:color="#FF1B2A78"/>
                <item android:offset="0.43" android:color="#FF6B4FC8"/>
                <item android:offset="0.5" android:color="#FFF7A21B"/>
                <item android:offset="0.57" android:color="#FF7CC6FF"/>
                <item android:offset="0.66" android:color="#FF2BA8FF"/>
                <item android:offset="0.75" android:color="#FF168FF0"/>
                <item android:offset="0.84" android:color="#FF2BA8FF"/>
                <item android:offset="0.93" android:color="#FF7CC6FF"/>
                <item android:offset="1" android:color="#FFF08A1A"/>
            </gradient>
        </aapt:attr>
    </path>
    </group>
    <path android:pathData="M 61.89,40.50 a 8.20,8.20 0 1,0 16.40,0 a 8.20,8.20 0 1,0 -16.40,0 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="67.89" android:centerY="38.30" android:gradientRadius="10">
                <item android:offset="0" android:color="#FFFFFCF2"/>
                <item android:offset="0.55" android:color="#FFFFDB8E"/>
                <item android:offset="1" android:color="#FFFFAA40"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
