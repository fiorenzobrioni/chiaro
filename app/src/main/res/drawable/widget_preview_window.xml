<?xml version="1.0" encoding="utf-8"?>
<!-- The window's picker preview ground (20 ott 2026): a clear night's gradient, the canvas'
     own three stops for a sun well under the horizon (DESIGN §3.3), with the launcher's own
     corner, as the running card has. A drawing of the product, never a reading. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF0B1430"
        android:centerColor="#FF14213F"
        android:endColor="#FF1E2E52" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
