<?xml version="1.0" encoding="utf-8"?>
<!-- The camera mark of Fase 28: the quiet glyph after the name of an event somebody
     would bring a camera to (the nine of sixty `SkyJob.photographic` allows).

     A drawing here rather than a Material icon, for two reasons that both matter. The
     project does not carry `material-icons-extended` and is not adding a megabyte of
     glyphs for one mark; and every piece of chrome this app draws itself already lives
     in this folder in one hand — `ic_verdict_*`, `ic_range_*`, `ic_warning` — so a
     borrowed icon at a different weight would be the odd one out on its own row.

     Same construction as those: stroked paths at 2.4 of 24, round caps and joins, which
     is ~1.8 dp at the 18 dp the Sky row shows it at — a shade lighter than the title
     beside it, which is what «not invasive» means in ink. The body is one rounded
     rectangle with the viewfinder bump on top, the lens a plain circle. The colour is
     irrelevant here: the row tints it to `onSurfaceVariant`, always. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M3.2,8.4 m0,2 a2,2 0 0 1 2,-2 L8.2,8.4 L9.8,5.8 L14.2,5.8 L15.8,8.4 L18.8,8.4 a2,2 0 0 1 2,2 L20.8,16.2 a2,2 0 0 1 -2,2 L5.2,18.2 a2,2 0 0 1 -2,-2 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.4" />
    <path
        android:pathData="M12,13.3 m-3,0 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.4" />
</vector>
