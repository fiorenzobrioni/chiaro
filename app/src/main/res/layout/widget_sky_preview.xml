<?xml version="1.0" encoding="utf-8"?>
<!-- The Sky widget in the picker: the moment in front of the reader, when, and its
     verdict. Same rules as `widget_now_preview` — sample values, the default dress baked
     in — and the same form: the wide one-row card the default placement (four cells by
     one, 8 set 2026) shows. Glyph at the height a one-row grant leaves; the clock at
     30sp over the name at 15sp; against the far edge the verdict's word chip over the
     number that decided it, in the measured ink-and-container pair — a verdict is a
     word before it is a color (DESIGN §2.3). Insets as the widget writes them: 4dp
     before the glyph, 6 above and below, 14 at the words' edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_sky"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp"
    tools:ignore="HardcodedText">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no"
        android:src="@drawable/mc3n_sunset" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="20:14"
            android:textColor="@color/widget_preview_ink"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/sky_name_sun_set"
            android:textColor="@color/widget_preview_ink_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- The verdict block: the word in its container, the number under it. -->
    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_verdict"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:singleLine="true"
            android:text="@string/verdict_pass"
            android:textColor="@color/widget_preview_verdict_ink"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:text="@string/widget_preview_evidence"
            android:textColor="@color/widget_preview_ink_dim"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
