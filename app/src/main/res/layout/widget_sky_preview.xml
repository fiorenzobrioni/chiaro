<?xml version="1.0" encoding="utf-8"?>
<!-- The Sky widget in the picker: the moment in front of the reader and its verdict.
     Same rules as `widget_now_preview` — sample values, the default dress baked in.
     The pill carries the measured ink-and-container pair, never a bare colored word:
     a verdict is a word before it is a color (DESIGN §2.3). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_sky"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/mcn_sunset" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="@string/sky_name_sun_set"
                android:textColor="@color/widget_preview_ink"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="20:14"
                android:textColor="@color/widget_preview_ink_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The verdict, with the number that decided it: the app's own pill, one moment
         of it. Two views because static XML has no spans. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_preview_verdict"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/verdict_pass"
            android:textColor="@color/widget_preview_verdict_ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text=" · "
            android:textColor="@color/widget_preview_verdict_ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/widget_preview_evidence"
            android:textColor="@color/widget_preview_verdict_ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
