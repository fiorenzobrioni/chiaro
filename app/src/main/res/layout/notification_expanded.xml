<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded body of a notification that carries a picture (23 set 2026): the title,
     the collapsed sentence as its headline, the picture, and the lines of the story under
     it. The system decorates it (header, icon, time) on every version this app runs on;
     the text takes the notification's own appearances, so it follows the system's day
     and night like any standard notification. Kept under the platform's 256 dp ceiling
     for an expanded custom view: two lines of title and headline, a picture of 60 to 90
     dp at a notification's width, and the lines of details the ceiling leaves room for.
     Which details go in, and how many lines they may take, is decided before the post by
     NotificationFit, measuring them at the phone's width and the reader's font scale
     (21 ott 2026); the notifier sets maxLines to that budget, and the value below is only
     the net above it, because a view that ellipsizes cuts a line's tail and drops what
     follows without a word. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notif_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/notif_headline"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />

    <!-- The picture twice, one per ground (30 set 2026): the system inflates this layout
         again when the shade changes between day and night, and the visibilities below
         come from values / values-night at that moment, so the picture on screen is always
         the one painted for the ground it is on. -->
    <ImageView
        android:id="@+id/notif_chart_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="@integer/notif_chart_day_visibility" />

    <ImageView
        android:id="@+id/notif_chart_night"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="@integer/notif_chart_night_visibility" />

    <TextView
        android:id="@+id/notif_details"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="6" />
</LinearLayout>
