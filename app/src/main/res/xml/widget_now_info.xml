<?xml version="1.0" encoding="utf-8"?>
<!-- The Now widget (VISION §5.9): icon, temperature, place, and the day's sentence
     where the grant has room. updatePeriodMillis is 0 on purpose — the shared periodic
     job drives every repaint, at the reader's own update frequency, instead of a second
     clock the battery pays for.

     Four cells by one as the default placement (8 set 2026, from three): that is the
     one-row form that carries the sentence, and the size the launcher's own weather
     widget opens at, so a reader meets the card with everything it can say. Two cells
     is still the floor (minWidth), and the reader can drag it anywhere from there.

     previewLayout is what the picker shows: Glance has no preview of its own, so
     without it the host advertises the generic loading card and all three widgets look
     alike. See `layout/widget_now_preview.xml`. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_now_desc"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_now_preview"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:configure="com.callbackdev.chiaro.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
